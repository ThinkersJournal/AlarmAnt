<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. allowBackup is already false; this states the same for lint and for tools that ignore it. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
